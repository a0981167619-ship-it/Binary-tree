class node: #使用指標建立二元樹
    def __init__(self,value):
        self.val=value #儲存節點的資料
        self.left=None  #指向左子節點
        self.right=None #指向右子節點
    def set_left(self,left):
        self.left=left
    def set_right(self,right):
        self.right=right

t1=node('A')
root=t1
t2=node('B')
t3=node('C')
t4=node('D')
t5=node('E')
t6=node('F')
t7=node('G')
t8=node('H')
t9=node('I')
t10=node('J')

t1.set_left(t2)
t2.set_left(t3)
t1.set_right(t4)
t4.set_left(t5)
t4.set_right(t6)
t3.set_left(t7)
t3.set_right(t8)
t6.set_left(t9)
t6.set_right(t10)

#輸出二元樹
def p_tree(node,level=0): #二元樹從0層開始計算
    if node is None: #判斷是否為空節點
        return 
    p_tree(node.right,level+1) #找目前節點的右子節點
    print("  "*level + str(node.val))              #依照右、root、左的順序
    p_tree(node.left,level+1) #找目前節點的左子節點

p_tree(root)



